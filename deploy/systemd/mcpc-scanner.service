[Unit]
Description=MCP connector scanner (supervised container)
After=network-online.target
Wants=network-online.target

[Service]
# The container runs in the foreground, so systemd sees it die and restarts it,
# the same way the application's own unit does.
Type=simple
WorkingDirectory=@REPO@
ExecStart=/usr/bin/make --no-print-directory serve
ExecStop=/usr/bin/podman stop -t 30 mcpc-scanner
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
