# Copy to .env and fill in. NEVER commit real values: .env and .env.* are gitignored.
# Used by `make up`, `make serve`, `make sweep` and the systemd units.
# Generate each secret with:  head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
# Keep the real file private:  chmod 600 .env

# The scanner's own database login (it can open only its own database)
SCANNER_DB_PASSWORD=

# Token the application server presents to read grades from the scanner API
SCANNER_API_TOKEN=

# Token the scanner presents to read the connector catalog from the server
SCAN_FEED_TOKEN=

# Where it connects (container names on the shared network)
SCANNER_PG_HOST=mcp-db
SCAN_FEED_URL=http://mcp-server:8080/internal/scanner/catalog

# How it runs
SCAN_INTERVAL_HOURS=168
SCAN_CONCURRENCY=32

# Only for the one-shot database init in compose.yaml (never given to the scanner):
# SCANNER_PG_ADMIN_USER=
# SCANNER_PG_ADMIN_PASSWORD=
