# MCP Connectors Scanner — one full sweep (system unit)
# Installed by `make host-install` next to mcp-connectors-scanner.service, with @USER@ and @REPO@
# filled in. Started by the timer of the same name, or by hand with
# `sudo systemctl start mcp-connectors-scanner-sweep`.
#
# It runs as the user who owns the checkout, because the containers, networks and volumes are that
# user's rootless podman. Run as root, it would look in an empty podman and fail.
# The script uses its own throwaway container, so it never touches the always-on scanner.

[Unit]
Description=MCP Connectors — Scanner, one full sweep
Documentation=https://github.com/sciensoft/mcp-connectors-scanner
After=network-online.target mcp-connectors.service

[Service]
Type=oneshot
User=@USER@
Group=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/deploy/sweep-once.sh
TimeoutStartSec=3h
Nice=10
StandardOutput=journal
StandardError=journal
